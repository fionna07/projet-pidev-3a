{% extends 'baseBack.html.twig' %}

{% block title %}Activités des utilisateurs{% endblock %}

{% block content %}
<div class="container">
    <div class="card shadow-lg p-4 rounded-4">
        <h1 class="mb-4 text-center">📊 Activités des utilisateurs</h1>

        <!-- Barre de recherche -->
        <form method="GET" action="{{ path('admin_activities') }}" class="mb-4">
            <div class="input-group shadow-sm w-50 mx-auto">
                <input type="text" name="search" class="form-control form-control-sm rounded-start" 
                       placeholder="🔍 Rechercher..." value="{{ search }}">
                <button type="submit" class="btn btn-primary btn-sm rounded-end">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>

        <!-- Bouton statistiques -->
        <div class="text-end mb-3">
            <a href="{{ path('admin_activities_stats') }}" class="btn btn-success btn-sm">
                <i class="fas fa-chart-bar"></i> Statistiques
            </a>
        </div>

        <!-- Tableau des activités -->
        <div class="table-responsive">
            <table class="table align-middle table-striped shadow-sm">
                <thead class="bg-light">
                    <tr>
                        <th>ID</th>
                        <th>Utilisateur</th>
                        <th>Action</th>
                        <th>Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activity in activities %}
                        <tr>
                            <td>{{ activity.id }}</td>
                            <td>{{ activity.user.email }}</td>
                           <td>
                            <span class="badge text-dark" style="background-color: #c0c0c0;">
                                <i class="fas fa-edit"></i> {{ activity.action }}
                            </span>
                        </td>

                            <td>{{ activity.date|date('d/m/Y H:i') }}</td>
                            <td class="text-center">
                                <!-- Bouton Modifier -->
                            

                              <!-- Bouton Supprimer -->
<button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" 
        data-url="{{ path('admin_activity_delete', {id: activity.id}) }}">
    <i class="fas fa-trash"></i>
</button>

<!-- Modal de confirmation -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmation de suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                Voulez-vous vraiment supprimer cette activité ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <a id="confirmDeleteButton" href="#" class="btn btn-danger">Supprimer</a>
            </div>
        </div>
    </div>
</div>

                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">Aucune activité trouvée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var confirmDeleteModal = document.getElementById("confirmDeleteModal");
        var confirmDeleteButton = document.getElementById("confirmDeleteButton");

        confirmDeleteModal.addEventListener("show.bs.modal", function(event) {
            var button = event.relatedTarget; // Le bouton qui a déclenché le modal
            var deleteUrl = button.getAttribute("data-url"); // Récupère l'URL

            confirmDeleteButton.setAttribute("href", deleteUrl); // Met à jour le lien de suppression
        });
    });
</script>

{% endblock %}
