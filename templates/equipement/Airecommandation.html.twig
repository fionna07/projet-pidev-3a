{% extends 'base.html.twig' %}

{% block title %}AI Sales Recommendation System{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/stylechat.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="chat-container">
        <div class="chat-header">
            <h2>AI Sales Recommendation System</h2>
        </div>

        <div class="chatlist">
          
        </div>
        
        <form action="#" class="typing_form">
            <input type="text" id="user-input" class="typing_input" placeholder="Describe the equipment you're looking for...">
            <button type="submit">Send</button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('front/chat.js') }}"></script>
{% endblock %}
