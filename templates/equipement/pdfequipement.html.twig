<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Équipements</title>
    <style>
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.5;
            color: #212529;
        }
        .container {
            width: 100%;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #198754;
            margin-bottom: 30px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #dee2e6;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #6c757d;
        }
        .logo {
            text-align: center;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <h2>WeFarm</h2>
            <p>Plateforme de l'Agriculture Intelligente et Durable</p>
        </div>
        
        <h1>Liste des Équipements</h1>
        
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prix (TND)</th>
                    <th>Quantité Disponible</th>
                    <th>Catégorie</th>
                    <th>Fournisseur</th>
                </tr>
            </thead>
            <tbody>
                {% for equipement in equipements %}
                    <tr>
                        <td>{{ equipement.id }}</td>
                        <td>{{ equipement.nom|capitalize }}</td>
                        <td>{{ equipement.prix }}</td>
                        <td>{{ equipement.quantiteDisponible }}</td>
                        <td>{{ equipement.categorie }}</td>
                        <td>{{ equipement.fournisseur.firstname }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="footer">
            <p>Document généré le {{ "now"|date("d/m/Y à H:i") }}</p>
            <p>© {{ "now"|date("Y") }} WeFarm - Tous droits réservés</p>
        </div>
    </div>
</body>
</html>