{% extends 'base.html.twig' %}

{% block title %}Ajouter une Offre d'Emploi{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-3">Ajouter une Offre d'Emploi</h2>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_errors(form) }}

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="{{ form.titre.vars.id }}" class="form-label">
                <i class="fas fa-briefcase"></i> {{ form_label(form.titre) }}
            </label>
            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.titre) }}
            </div>
        </div>

        <div class="col-md-6">
            <label for="{{ form.nombrePostes.vars.id }}" class="form-label">
                <i class="fas fa-users"></i> {{ form_label(form.nombrePostes) }}
            </label>
            {{ form_widget(form.nombrePostes, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.nombrePostes) }}
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="{{ form.description.vars.id }}" class="form-label">
                <i class="fas fa-align-left"></i> {{ form_label(form.description) }}
            </label>
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="col-md-6">
            <label for="{{ form.dateDebut.vars.id }}" class="form-label">
                <i class="fas fa-calendar-alt"></i> {{ form_label(form.dateDebut) }}
            </label>
            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.dateDebut) }}
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="{{ form.dateFinEstimee.vars.id }}" class="form-label">
                <i class="fas fa-calendar-times"></i> {{ form_label(form.dateFinEstimee) }}
            </label>
            {{ form_widget(form.dateFinEstimee, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.dateFinEstimee) }}
            </div>
        </div>

        <div class="col-md-6">
            <label for="{{ form.localisation.vars.id }}" class="form-label">
                <i class="fas fa-map-marker-alt"></i> {{ form_label(form.localisation) }}
            </label>
            {{ form_widget(form.localisation, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.localisation) }}
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="{{ form.competencesRequises.vars.id }}" class="form-label">
                <i class="fas fa-cogs"></i> {{ form_label(form.competencesRequises) }}
            </label>
            {{ form_widget(form.competencesRequises, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.competencesRequises) }}
            </div>
        </div>

        <div class="col-md-6">
            <label for="{{ form.salaire.vars.id }}" class="form-label">
                <i class="fas fa-file-invoice"></i> {{ form_label(form.salaire) }}
            </label>
            {{ form_widget(form.salaire, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger">
                {{ form_errors(form.salaire) }}
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
    <a href="{{ path('app_offreEmploi') }}" class="btn btn-white">
        <i class="fas fa-times-circle"></i> Annuler
    </a>
    <button type="submit" class="btn btn-primary me-2">
        <i class="fas fa-plus-circle"></i> Ajouter
    </button>
    </div>


    {{ form_end(form) }}
</div>

{% endblock %}
